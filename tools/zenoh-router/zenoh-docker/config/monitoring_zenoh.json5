{
  "mode": "router",
  "plugins": {
      "rest": {
        /// Setting this option to true allows zenohd to panic should it detect issues with this plugin. Setting it to false politely asks the plugin not to panic.
        __required__: true, // defaults to false
        /// http port to answer to rest requests
        http_port: 8000,
        /// The number of worker thread in TOKIO runtime (default: 2)
        /// The configuration only takes effect if running as a dynamic plugin, which can not reuse the current runtime.
        work_thread_num: 2,
        /// The number of blocking thread in TOKIO runtime (default: 50)
        /// The configuration only takes effect if running as a dynamic plugin, which can not reuse the current runtime.
        max_block_thread_num: 50,
      },
    "storage_manager": {
      "volumes": {
        "influxdb": {
          "url": "https://eu-central-1-1.aws.cloud2.influxdata.com",
          "private": {
            "token": "kOJYgKYtx7YJh_yIRBkejaRU37penO1VIpXhEEePjF6nyTw62g0il96-cCOcZXyUfvroUM1kUQZ69MseV6qfKQ==",
            "org_id": "c6bdd238911e45a1"
          }
        },
        "influxdb2": {
          "url": "http://localhost:8086",
          "private": {
            "token": "1UF0JGZNRLP0LunZQm1VXkabOie1qalE9DYBCPvC3Wq1Blepb3ihScv_TO74iTVW_tIO0hIbThEFggZUXGGFzw==",
            "org_id": "467461f410e6c868"
          }
        }
      },
      "storages": {
        "demo": {
          "key_expr": "Vehicle/1/**",
          "volume": {
            "id": "influxdb",
            "db": "jetracer",
          }
        },
        "demo_external": {
          "key_expr": "Vehicle/1/**",
          "volume": {
            "id": "influxdb2",
            "db": "jetracer",
          }
        },
      }
    }
  },
    "scouting": {
        "multicast": {
            "enabled": false
        },
        "gossip": {
            "enabled": false
        }
    },
    "connect": {
        "endpoints": ["tcp/127.0.0.1:7448", "tcp/127.0.0.1:7449", "tcp/127.0.0.1:7450", "tcp/127.0.0.1:7451"]
    },
    "listen": {
        "endpoints": ["tcp/0.0.0.0:7447"]
    },
}
