FROM ruipires99/jetsoncrosscompile:0.0.2

ARG projectDir

RUN rm -rf /home$projectDir

RUN mkdir -p /home$projectDir

COPY $projectDir /home$projectDir

RUN cd /home$projectDir && \
    cmake . \
    -DCMAKE_BUILD_TYPE=Debug \
    -DZENOHCXX_ZENOHC=ON && \
    # -DENABLE_COVERAGE=ON \
    # -DBUILD_TESTING=ON && \
    cmake --build .
